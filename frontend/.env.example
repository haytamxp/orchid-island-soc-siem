# ==========================================
# CONFIGURATION DES NOTIFICATIONS SOC-AI
# ==========================================

# 1. Configuration TELEGRAM
# Obtenez votre token auprès de @BotFather
TELEGRAM_BOT_TOKEN="REMPLACEZ_PAR_VOTRE_TOKEN_BOT"
# Obtenez votre Chat ID via @userinfobot ou l'API Telegram
TELEGRAM_CHAT_ID="REMPLACEZ_PAR_VOTRE_CHAT_ID"

# 2. Configuration EMAIL (Exemple avec Gmail)
SMTP_SERVICE="gmail"
SMTP_USER="votre-email@gmail.com"
# Utilisez un "Mot de passe d'application", pas votre vrai mot de passe
SMTP_PASS="votre-mot-de-passe-application"
# Adresse email qui va recevoir les alertes
NOTIFICATION_EMAIL="destinataire@entreprise.com"
