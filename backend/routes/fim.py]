"""
FIM API routes.

Endpoints:
    GET  /api/fim
    GET  /api/fim/baselines
    POST /api/fim/baselines
    POST /api/fim/events
"""

from __future__ import annotations

import os
from datetime import datetime

from flask import Blueprint, jsonify, request

from backend.schemas.fim import (
    normalize_baseline_payload,
    normalize_event_payload,
    normalize_limit,
)
from backend.services.fim import (
    snapshot_file,
    severity_for_path,
)
from backend.services.fim_storage import (
    get_baseline,
    insert_fim_event,
    list_baselines,
    list_fim_events,
    upsert_baseline,
)


fim_bp = Blueprint(
    "fim",
    __name__,
    url_prefix="/api/fim",
)


def _serialize_row(row: dict) -> dict:
    """
    Convert datetime objects to JSON-compatible strings.
    """

    result = dict(row)

    for key, value in result.items():
        if isinstance(value, datetime):
            result[key] = value.isoformat()

    return result


@fim_bp.route("", methods=["GET"])
def get_fim():
    """
    List FIM events.
    """

    hostname = request.args.get("hostname") or None
    severity = request.args.get("severity") or None
    change_type = request.args.get("change_type") or None

    limit = normalize_limit(
        request.args.get("limit", 200)
    )

    try:
        rows = list_fim_events(
            hostname=hostname,
            severity=severity,
            change_type=change_type,
            limit=limit,
        )

        return jsonify([
            _serialize_row(row)
            for row in rows
        ]), 200

    except Exception as exc:
        return jsonify({
            "error": "Failed to retrieve FIM events",
            "details": str(exc),
        }), 500


@fim_bp.route("/baselines", methods=["GET"])
def get_baselines():
    """
    List trusted FIM baselines.
    """

    hostname = request.args.get("hostname") or None

    try:
        rows = list_baselines(hostname=hostname)

        return jsonify([
            _serialize_row(row)
            for row in rows
        ]), 200

    except Exception as exc:
        return jsonify({
            "error": "Failed to retrieve FIM baselines",
            "details": str(exc),
        }), 500


@fim_bp.route("/baselines", methods=["POST"])
def create_baseline():
    """
    Create a trusted baseline from the current file state.

    Example:
        {
            "hostname": "soc-web-prod-01",
            "file_path": "/etc/passwd"
        }
    """

    try:
        payload = normalize_baseline_payload(
            request.get_json(silent=True) or {}
        )

        hostname = payload["hostname"]
        file_path = payload["file_path"]

        if not os.path.isfile(file_path):
            return jsonify({
                "error": "File does not exist",
                "file_path": file_path,
            }), 404

        snapshot = snapshot_file(file_path)

        upsert_baseline(
            hostname=hostname,
            file_path=snapshot.path,
            sha256=snapshot.sha256,
            file_size=snapshot.size,
            mode=snapshot.mode,
            owner_name=snapshot.owner,
        )

        return jsonify({
            "message": "FIM baseline created",
            "hostname": hostname,
            "file_path": snapshot.path,
            "sha256": snapshot.sha256,
            "size": snapshot.size,
            "mode": snapshot.mode,
            "owner": snapshot.owner,
        }), 201

    except ValueError as exc:
        return jsonify({
            "error": str(exc),
        }), 400

    except FileNotFoundError as exc:
        return jsonify({
            "error": "File does not exist",
            "file_path": str(exc),
        }), 404

    except OSError as exc:
        return jsonify({
            "error": "Unable to read file",
            "details": str(exc),
        }), 500

    except Exception as exc:
        return jsonify({
            "error": "Failed to create FIM baseline",
            "details": str(exc),
        }), 500


@fim_bp.route("/events", methods=["POST"])
def create_fim_event():
    """
    Receive a FIM event generated by an agent.
    """

    try:
        payload = normalize_event_payload(
            request.get_json(silent=True) or {}
        )

        event_id = insert_fim_event(
            hostname=payload["hostname"],
            file_path=payload["file_path"],
            change_type=payload["change_type"],
            old_hash=payload["old_hash"],
            new_hash=payload["new_hash"],
            old_size=payload["old_size"],
            new_size=payload["new_size"],
            severity=payload["severity"],
            actor=payload["actor"],
            process_name=payload["process_name"],
            agent_id=payload["agent_id"],
            details=payload["details"],
        )

        return jsonify({
            "message": "FIM event stored",
            "event_id": event_id,
        }), 201

    except ValueError as exc:
        return jsonify({
            "error": str(exc),
        }), 400

    except Exception as exc:
        return jsonify({
            "error": "Failed to store FIM event",
            "details": str(exc),
        }), 500


@fim_bp.route("/check", methods=["POST"])
def check_fim_file():
    """
    Compare a file with its trusted baseline.

    This endpoint is useful for controlled testing and local validation.
    The production agent will eventually perform this comparison locally
    and send the resulting event to /api/fim/events.
    """

    try:
        payload = normalize_baseline_payload(
            request.get_json(silent=True) or {}
        )

        hostname = payload["hostname"]
        file_path = payload["file_path"]

        baseline = get_baseline(
            hostname=hostname,
            file_path=file_path,
        )

        if baseline is None:
            return jsonify({
                "error": "No baseline exists for this file",
                "hostname": hostname,
                "file_path": file_path,
            }), 404

        current = None

        if os.path.isfile(file_path):
            current = snapshot_file(file_path)

        baseline_hash = baseline.get("sha256")
        baseline_size = baseline.get("file_size")

        if current is None:
            change_type = "deleted"

            response = {
                "hostname": hostname,
                "file_path": file_path,
                "status": "changed",
                "change_type": change_type,
                "old_hash": baseline_hash,
                "new_hash": None,
                "old_size": baseline_size,
                "new_size": None,
                "severity": severity_for_path(
                    file_path,
                    change_type,
                ),
            }

            return jsonify(response), 200

        if current.sha256 == baseline_hash:
            return jsonify({
                "hostname": hostname,
                "file_path": file_path,
                "status": "unchanged",
                "change_type": "unchanged",
                "sha256": current.sha256,
                "size": current.size,
            }), 200

        change_type = "modified"

        return jsonify({
            "hostname": hostname,
            "file_path": file_path,
            "status": "changed",
            "change_type": change_type,
            "old_hash": baseline_hash,
            "new_hash": current.sha256,
            "old_size": baseline_size,
            "new_size": current.size,
            "severity": severity_for_path(
                file_path,
                change_type,
            ),
        }), 200

    except ValueError as exc:
        return jsonify({
            "error": str(exc),
        }), 400

    except FileNotFoundError:
        return jsonify({
            "error": "File does not exist",
        }), 404

    except OSError as exc:
        return jsonify({
            "error": "Unable to inspect file",
            "details": str(exc),
        }), 500

    except Exception as exc:
        return jsonify({
            "error": "FIM check failed",
            "details": str(exc),
        }), 500